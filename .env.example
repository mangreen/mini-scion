# Address the server listens on. Keep it on loopback only (Go 1.24 no longer gets security fixes).
SCION_ADDR=127.0.0.1:8080

# Directory where the server stores blobs, the WAL and refs.
SCION_DATA_DIR=./data

# FIXME: Replace with a real value via your own .env; never commit it.
SCION_AUTH_TOKEN=changeme
